{
  "arrowParens": "always",
  "bracketSpacing": true,
  "singleQuote": true,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "trailingComma": "es5",
  "printWidth": 100,
  "proseWrap": "never",
  "overrides": [
    {
      "files": ["*.css"],
      "options": { "parser": "css", "singleQuote": false }
    }
  ]
}
